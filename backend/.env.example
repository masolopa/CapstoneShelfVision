# Copiar a .env para una instalación local sin Docker.
REGOVA_DB_HOST=127.0.0.1
REGOVA_DB_PORT=5432
REGOVA_DB_NAME=REGOVA_BD
REGOVA_DB_USER=regova_app
REGOVA_DB_PASSWORD=REEMPLAZAR
REGOVA_STORAGE_ROOT=./storage
REGOVA_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8011,http://localhost:8011
REGOVA_COOKIE_SECURE=false

# Recuperación de acceso (credenciales solo en .env)
REGOVA_SMTP_HOST=
REGOVA_SMTP_PORT=587
REGOVA_SMTP_SECURITY=starttls
REGOVA_SMTP_USER=
REGOVA_SMTP_PASSWORD=
REGOVA_SMTP_FROM=
REGOVA_PUBLIC_URL=http://127.0.0.1:8011
